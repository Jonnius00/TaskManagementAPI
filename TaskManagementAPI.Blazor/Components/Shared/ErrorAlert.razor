@*
    Reusable error alert component with dismiss functionality
    Usage: <ErrorAlert Message="@ErrorMessage" OnDismiss="() => ErrorMessage = string.Empty" />
*@

@if (!string.IsNullOrEmpty(Message))
{
    <div class="alert alert-@Variant alert-dismissible fade show" role="alert">
        @if (ShowIcon)
        {
            <strong>⚠️ </strong>
        }
        @Message
        @if (IsDismissible)
        {
            <button type="button" class="btn-close" @onclick="HandleDismiss"></button>
        }
    </div>
}

@code {
    /// <summary>
    /// Error message to display
    /// </summary>
    [Parameter]
    public string Message { get; set; } = string.Empty;

    /// <summary>
    /// Bootstrap variant: danger (default), warning, info
    /// </summary>
    [Parameter]
    public string Variant { get; set; } = "danger";

    /// <summary>
    /// Show icon before message
    /// </summary>
    [Parameter]
    public bool ShowIcon { get; set; } = true;

    /// <summary>
    /// Allow user to dismiss the alert
    /// </summary>
    [Parameter]
    public bool IsDismissible { get; set; } = true;

    /// <summary>
    /// Callback when alert is dismissed
    /// </summary>
    [Parameter]
    public EventCallback OnDismiss { get; set; }

    private async Task HandleDismiss()
    {
        Message = string.Empty;
        if (OnDismiss.HasDelegate)
        {
            await OnDismiss.InvokeAsync();
        }
    }
}
