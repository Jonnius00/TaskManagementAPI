@* 
    Reusable loading spinner component
    Usage: <LoadingSpinner Message="Loading projects..." Size="large" />
*@

<div class="text-center py-5">
    <div class="spinner-border @SizeClass @ColorClass" role="status">
        <span class="visually-hidden">@Message</span>
    </div>
    @if (!string.IsNullOrEmpty(Message))
    {
        <div class="mt-3">
            <p class="text-muted">@Message</p>
        </div>
    }
</div>

@code {
    /// <summary>
    /// Message to display below the spinner
    /// </summary>
    [Parameter]
    public string Message { get; set; } = "Loading...";

    /// <summary>
    /// Size of the spinner: small, medium (default), large
    /// </summary>
    [Parameter]
    public string Size { get; set; } = "medium";

    /// <summary>
    /// Color variant: primary (default), secondary, success, danger, warning, info
    /// </summary>
    [Parameter]
    public string Color { get; set; } = "primary";

    private string SizeClass => Size.ToLower() switch
    {
        "small" => "spinner-border-sm",
        "large" => "spinner-border-lg",
        _ => ""
    };

    private string ColorClass => $"text-{Color.ToLower()}";
}
