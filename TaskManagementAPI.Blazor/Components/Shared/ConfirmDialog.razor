@* Reusable confirmation dialog *@

@if (IsVisible)
{
  <div class="modal d-block" role="dialog" aria-modal="true"
     style="position:fixed; inset:0; display:flex; align-items:center; justify-content:center; background-color: rgba(0,0,0,0.5); z-index:1050;">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">@Title</h5>
          <button type="button" class="btn-close" aria-label="Close" @onclick="Cancel"></button>
        </div>
        <div class="modal-body">
          <p>@Message</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" @onclick="Cancel">
            @CancelButtonText
          </button>
          <button type="button" class="@($"btn btn-{ConfirmButtonVariant}")" @onclick="Confirm">
            @ConfirmButtonText
          </button>
        </div>
      </div>
    </div>
  </div>
}

@code {
  private bool IsVisible { get; set; } = false;
  private string Title { get; set; } = "Confirm Action";
  private string Message { get; set; } = "Are you sure?";
  private TaskCompletionSource<bool>? _taskCompletionSource;

  [Parameter] public string ConfirmButtonText { get; set; } = "Confirm";
  [Parameter] public string CancelButtonText { get; set; } = "Cancel";
  [Parameter] public string ConfirmButtonVariant { get; set; } = "danger";

  public Task<bool> ShowAsync(string title, string message)
  {
    Title = title;
    Message = message;
    IsVisible = true;
    
    // ensure continuations run asynchronously to avoid potential deadlocks in the UI context
    // _taskCompletionSource = new TaskCompletionSource<bool>(TaskCreationOptions.RunContinuationsAsynchronously);
    // InvokeAsync(StateHasChanged); // schedule a UI refresh
    // BOTH DOES NOT WORK
    _taskCompletionSource = new TaskCompletionSource<bool>();
    StateHasChanged();
    
    return _taskCompletionSource.Task;
  }

  private void Confirm()
  {
    IsVisible = false;
    _taskCompletionSource?.SetResult(true);
    StateHasChanged();
  }

  private void Cancel()
  {
    IsVisible = false;
    _taskCompletionSource?.SetResult(false);
    StateHasChanged();
  }
}
